<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#090D1C" android:centerColor="#242052" android:endColor="#102D42" />
        </shape>
    </item>
    <item android:gravity="center" android:width="104dp" android:height="104dp">
        <shape android:shape="oval">
            <solid android:color="#3D345F" />
            <stroke android:width="2dp" android:color="#B9A5FF" />
        </shape>
    </item>
    <item android:gravity="center" android:width="48dp" android:height="48dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#8B6CFF" />
        </shape>
    </item>
</layer-list>